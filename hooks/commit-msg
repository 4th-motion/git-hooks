#!/bin/bash

MESSAGE_FILE=$1

if [ ! -f "$MESSAGE_FILE" ]; then
  printf 'Could not read the commit message file: %s\n' "$MESSAGE_FILE" >&2
  exit 1
fi

IFS= read -r MESSAGE < "$MESSAGE_FILE"
BRANCH=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)
CONVENTIONAL_REGEX='^(build|bump|chore|ci|docs|feat|fix|i18n|perf|refactor|revert|style|test)(\([a-z0-9][a-z0-9._/-]*\))?!?: [^[:space:]].*$'
CLICKUP_REGEX='^CU-[A-Za-z0-9]+: [^[:space:]].*$'

# Merge commits from git pull/merge keep Git's own "Merge ..." message
if git rev-parse --quiet --verify MERGE_HEAD >/dev/null; then
  IS_MERGE=1
fi

if [ -z "$IS_MERGE" ] && [[ ! $MESSAGE =~ $CONVENTIONAL_REGEX ]] && [[ ! $MESSAGE =~ $CLICKUP_REGEX ]]; then
  cat >&2 <<'ERROR_MESSAGE'
Your commit message format is invalid.

Valid examples:
  fix: preserve task output
  fix(backend): preserve task output
  feat(api)!: remove a legacy endpoint
  CU-123abc: preserve task output

Scopes are optional, must be lowercase, and are not allowed after a ClickUp ID.
ERROR_MESSAGE
  exit 1
fi

if [ "$BRANCH" = "master" ]; then
  echo "You can't commit directly to master branch." >&2
  exit 1
fi
