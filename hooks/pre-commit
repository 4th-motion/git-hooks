#!/bin/bash

# find all tasks in HOOK_NAME from package.json
HOOK_NAME='pre-commit'
TASKS=$(node ./.git/hooks/detectHook.js "$HOOK_NAME")
DETECT_HOOK_EXIT_CODE=$?

if [ "$DETECT_HOOK_EXIT_CODE" -ne 0 ]; then
  exit "$DETECT_HOOK_EXIT_CODE"
fi

TASK_NAMES=($TASKS)

for TASK_NAME in "${TASK_NAMES[@]}"
do
  printf '[pre-commit] Running "%s"...\n' "$TASK_NAME"
  yarn run "$TASK_NAME"
  TASK_EXIT_CODE=$?

  if [ "$TASK_EXIT_CODE" -ne 0 ]; then
    printf '[pre-commit] Task "%s" failed with exit code %s.\n' "$TASK_NAME" "$TASK_EXIT_CODE" >&2
    exit "$TASK_EXIT_CODE"
  fi
done
